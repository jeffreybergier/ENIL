{
  "app_name": "ENIL",
  "tag_prefix": "v",
  "version": {
    "source": "source/macOS/Info.plist",
    "keys": [
      "CFBundleShortVersionString",
      "CFBundleVersion"
    ],
    "plists": [
      "source/macOS/Info.plist",
      "source/iOS/Info.plist"
    ]
  },
  "release": {
    "commit_message": "chore(release): release {version}"
  },
  "targets": [
    {
      "name": "macOS",
      "workdir": ".",
      "build": [
        {
          "shell": "make macOS-clean"
        },
        {
          "shell": "make macOS-release"
        }
      ],
      "artifact": "build/macOS/release/ENIL/ENIL.zip",
      "asset_name": "ENIL-{version}-macOS.zip"
    },
    {
      "name": "iOS",
      "workdir": ".",
      "build": [
        {
          "shell": "make iOS-clean"
        },
        {
          "shell": "make iOS-release"
        }
      ],
      "artifact": "build/iOS/release/ENIL/ENIL.ipa",
      "asset_name": "ENIL-{version}-iOS.ipa"
    }
  ],
  "schema_version": 1,
  "stage_dir": "dist"
}
